<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<org.koitharu.kotatsu.core.ui.sheet.AdaptiveSheetHeaderBar
		android:id="@+id/headerBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:title="@string/community_comments" />

	<LinearLayout
		android:id="@+id/layout_header_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp"
		android:paddingBottom="8dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginEnd="8dp"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/textView_sheet_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:text="@string/community_comments"
				android:textAppearance="?attr/textAppearanceTitleMedium" />

			<TextView
				android:id="@+id/textView_sheet_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?android:attr/textColorSecondary"
				android:visibility="gone"
				tools:text="Chapter 42"
				tools:visibility="visible" />
		</LinearLayout>

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/toggleGroup_mode"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:visibility="gone"
			app:selectionRequired="true"
			app:singleSelection="true"
			tools:visibility="visible">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_mode_native"
				style="?materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="36dp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:minHeight="0dp"
				android:paddingHorizontal="12dp"
				android:text="@string/community_comments" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_mode_widget"
				style="?materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="36dp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:minHeight="0dp"
				android:paddingHorizontal="12dp"
				android:text="@string/community_web_comments" />
		</com.google.android.material.button.MaterialButtonToggleGroup>
	</LinearLayout>

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/container_native"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<TextView
				android:id="@+id/textView_stats"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:paddingHorizontal="16dp"
				android:paddingBottom="6dp"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?android:attr/textColorSecondary"
				android:visibility="gone"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				tools:text="4.6 ★ · 128 ratings · 24 comments"
				tools:visibility="visible" />

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_auth_banner"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="16dp"
				android:layout_marginBottom="6dp"
				android:visibility="gone"
				app:cardBackgroundColor="?attr/colorSecondaryContainer"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_stats"
				app:strokeWidth="0dp"
				tools:visibility="visible">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingHorizontal="14dp"
					android:paddingVertical="8dp">

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginEnd="8dp"
						android:layout_weight="1"
						android:text="@string/community_sign_in_to_comment"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:textColor="?attr/colorOnSecondaryContainer" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_auth_sign_in"
						style="@style/Widget.Kotatsu.Expressive.Button.Tonal"
						android:layout_width="wrap_content"
						android:layout_height="36dp"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minHeight="0dp"
						android:text="@string/sign_in" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<HorizontalScrollView
				android:id="@+id/scrollView_sort"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:paddingHorizontal="16dp"
				android:scrollbars="none"
				android:visibility="gone"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/card_auth_banner"
				tools:visibility="visible">

				<com.google.android.material.chip.ChipGroup
					android:id="@+id/chipGroup_sort"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					app:selectionRequired="true"
					app:singleLine="true"
					app:singleSelection="true">

					<com.google.android.material.chip.Chip
						android:id="@+id/chip_sort_new"
						style="@style/Widget.Material3.Chip.Filter"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/community_comments_sort_new" />

					<com.google.android.material.chip.Chip
						android:id="@+id/chip_sort_top"
						style="@style/Widget.Material3.Chip.Filter"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/community_comments_sort_top" />

					<com.google.android.material.chip.Chip
						android:id="@+id/chip_sort_old"
						style="@style/Widget.Material3.Chip.Filter"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/community_comments_sort_old" />
				</com.google.android.material.chip.ChipGroup>
			</HorizontalScrollView>

			<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
				android:id="@+id/swipeRefreshLayout"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_marginTop="4dp"
				app:layout_constraintBottom_toTopOf="@id/card_compose"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/scrollView_sort">

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerView_comments"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:clipToPadding="false"
					android:paddingHorizontal="16dp"
					android:paddingTop="4dp"
					android:paddingBottom="12dp"
					app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
					tools:itemCount="4"
					tools:listitem="@layout/item_source_comment" />
			</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

			<com.google.android.material.loadingindicator.LoadingIndicator
				android:id="@+id/progressIndicator_native"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:visibility="gone"
				app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout" />

			<LinearLayout
				android:id="@+id/layout_empty_native"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingHorizontal="32dp"
				android:visibility="gone"
				app:layout_constraintBottom_toBottomOf="@id/swipeRefreshLayout"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="@id/swipeRefreshLayout">

				<TextView
					android:id="@+id/textView_empty_native"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:drawablePadding="12dp"
					android:gravity="center"
					android:text="@string/community_comments_empty"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:textColor="?android:attr/textColorSecondary"
					app:drawableTint="?android:attr/textColorSecondary"
					app:drawableTopCompat="@drawable/ic_comment" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_native_action"
					style="@style/Widget.Kotatsu.Expressive.Button.Tonal"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:visibility="gone"
					tools:text="@string/try_again" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_native_fallback_web"
					style="@style/Widget.Kotatsu.Expressive.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/community_web_comments"
					android:visibility="gone" />
			</LinearLayout>

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_compose"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="12dp"
				android:layout_marginBottom="8dp"
				android:visibility="gone"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				app:cardCornerRadius="24dp"
				app:cardElevation="0dp"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:strokeWidth="0dp"
				tools:visibility="visible">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="10dp">

					<LinearLayout
						android:id="@+id/layout_compose_target"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingHorizontal="4dp"
						android:visibility="gone"
						tools:visibility="visible">

						<TextView
							android:id="@+id/textView_compose_target"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:ellipsize="end"
							android:maxLines="1"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:textColor="?attr/colorPrimary"
							tools:text="Replying to reader" />

						<com.google.android.material.button.MaterialButton
							android:id="@+id/button_cancel_compose"
							style="?attr/borderlessButtonStyle"
							android:layout_width="wrap_content"
							android:layout_height="32dp"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:minWidth="0dp"
							android:minHeight="0dp"
							android:text="@android:string/cancel" />
					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingTop="2dp">

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_spoiler"
							style="@style/Widget.Material3.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:checkable="true"
							android:text="@string/community_comment_spoiler"
							app:chipIcon="@drawable/ic_eye_off"
							app:chipIconVisible="true" />
					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:baselineAligned="false"
						android:gravity="bottom"
						android:orientation="horizontal">

						<com.google.android.material.textfield.TextInputLayout
							android:id="@+id/textInputLayout_comment"
							style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:hint="@string/community_comment_hint"
							app:boxCornerRadiusBottomEnd="20dp"
							app:boxCornerRadiusBottomStart="20dp"
							app:boxCornerRadiusTopEnd="20dp"
							app:boxCornerRadiusTopStart="20dp">

							<com.google.android.material.textfield.TextInputEditText
								android:id="@+id/editText_comment"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:inputType="textMultiLine|textCapSentences"
								android:maxLength="4000"
								android:maxLines="4"
								android:minLines="1" />
						</com.google.android.material.textfield.TextInputLayout>

						<com.google.android.material.button.MaterialButton
							android:id="@+id/button_send"
							style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
							android:layout_width="50dp"
							android:layout_height="50dp"
							android:layout_marginStart="8dp"
							android:contentDescription="@string/community_comment_send"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:minWidth="0dp"
							android:minHeight="0dp"
							android:paddingStart="0dp"
							android:paddingEnd="0dp"
							app:icon="@drawable/ic_send"
							app:iconGravity="textStart"
							app:iconPadding="0dp"
							app:iconSize="22dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

		</androidx.constraintlayout.widget.ConstraintLayout>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/container_widget"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/layout_widget_toolbar"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingHorizontal="12dp"
				android:paddingBottom="4dp"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<TextView
					android:id="@+id/textView_widget_url"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:ellipsize="end"
					android:maxLines="1"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:textColor="?android:attr/textColorSecondary"
					tools:text="https://disqus.com/embed/comments/..." />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_widget_refresh"
					style="?materialIconButtonStyle"
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:contentDescription="@string/try_again"
					android:insetTop="0dp"
					android:insetBottom="0dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					app:icon="@drawable/ic_retry"
					app:iconSize="18dp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_widget_open_browser"
					style="?attr/borderlessButtonStyle"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:insetTop="0dp"
					android:insetBottom="0dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:text="@string/open_in_browser"
					app:icon="@drawable/ic_open_external"
					app:iconSize="16dp" />
			</LinearLayout>

			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/progressBar_widget"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:indeterminate="true"
				android:visibility="gone"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/layout_widget_toolbar" />

			<FrameLayout
				android:id="@+id/container_webView"
				android:layout_width="0dp"
				android:layout_height="0dp"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/progressBar_widget" />

			<LinearLayout
				android:id="@+id/layout_widget_error"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:background="?attr/colorSurface"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="24dp"
				android:visibility="gone"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/progressBar_widget">

				<ImageView
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:contentDescription="@null"
					android:src="@drawable/ic_error_small"
					app:tint="?attr/colorError" />

				<TextView
					android:id="@+id/textView_widget_error"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:gravity="center"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					tools:text="@string/community_widget_load_error" />

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:orientation="horizontal">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_widget_error_retry"
						style="@style/Widget.Kotatsu.Expressive.Button.Tonal"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginEnd="8dp"
						android:text="@string/try_again" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_widget_error_browser"
						style="@style/Widget.Kotatsu.Expressive.Button"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/open_in_browser" />
				</LinearLayout>
			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>
	</FrameLayout>

</LinearLayout>
