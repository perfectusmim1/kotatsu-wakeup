<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/layout_main"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<org.koitharu.kotatsu.core.ui.sheet.AdaptiveSheetHeaderBar
		android:id="@+id/headerBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:title="@string/upscale_title" />

	<androidx.core.widget.NestedScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipToPadding="false"
		android:scrollbars="vertical">

		<LinearLayout
			android:id="@+id/layout_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="@dimen/margin_normal">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="@dimen/margin_normal"
				android:layout_marginTop="@dimen/margin_small"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/upscale_mode_label"
					android:textAppearance="@style/TextAppearance.Kotatsu.GridTitle" />

				<TextView
					android:id="@+id/textView_upscale_processing"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/upscale_processing"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:textColor="?attr/colorPrimary"
					android:visibility="gone"
					tools:visibility="visible" />

			</LinearLayout>

			<com.google.android.material.button.MaterialButtonToggleGroup
				android:id="@+id/toggleGroup_upscale_mode"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="@dimen/margin_normal"
				android:layout_marginTop="@dimen/margin_small"
				app:selectionRequired="true"
				app:singleSelection="true">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_upscale_off"
					style="?materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:maxLines="1"
					android:paddingHorizontal="6dp"
					android:text="@string/upscale_mode_off" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_upscale_fast"
					style="?materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:maxLines="1"
					android:paddingHorizontal="6dp"
					android:text="@string/upscale_mode_fast" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_upscale_ai"
					style="?materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:maxLines="1"
					android:paddingHorizontal="6dp"
					android:text="@string/upscale_mode_ai" />

			</com.google.android.material.button.MaterialButtonToggleGroup>

			<TextView
				android:id="@+id/textView_upscale_mode_hint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="@dimen/margin_normal"
				android:layout_marginTop="@dimen/margin_small"
				android:text="@string/upscale_hint_off"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?android:attr/textColorSecondary" />

			<TextView
				android:id="@+id/textView_upscale_device_hint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="@dimen/margin_normal"
				android:layout_marginTop="4dp"
				android:text="@string/upscale_low_ram_hint"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?attr/colorTertiary"
				android:visibility="gone"
				tools:visibility="visible" />

			<LinearLayout
				android:id="@+id/layout_upscale_model_status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="@dimen/margin_normal"
				android:layout_marginTop="@dimen/margin_small"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:id="@+id/textView_upscale_model_status"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="@string/upscale_model_ready"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:textColor="?android:attr/textColorSecondary" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_download_upscale_model"
						style="@style/Widget.Material3.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minHeight="36dp"
						android:text="@string/upscale_model_download"
						android:visibility="gone"
						tools:visibility="visible" />

				</LinearLayout>

				<com.google.android.material.progressindicator.LinearProgressIndicator
					android:id="@+id/progress_upscale_download"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:visibility="gone"
					tools:progress="45"
					tools:visibility="visible" />

			</LinearLayout>

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_upscale_compare"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:minHeight="?android:listPreferredItemHeightSmall"
				android:paddingStart="?android:listPreferredItemPaddingStart"
				android:paddingEnd="?android:listPreferredItemPaddingEnd"
				android:text="@string/upscale_compare_toggle"
				android:textAppearance="@style/TextAppearance.Kotatsu.GridTitle"
				android:textColor="?colorOnSurfaceVariant" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_upscale_high_res"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:minHeight="?android:listPreferredItemHeightSmall"
				android:paddingStart="?android:listPreferredItemPaddingStart"
				android:paddingEnd="?android:listPreferredItemPaddingEnd"
				android:text="@string/upscale_high_res_toggle"
				android:textAppearance="@style/TextAppearance.Kotatsu.GridTitle"
				android:textColor="?colorOnSurfaceVariant" />

			<TextView
				android:id="@+id/textView_upscale_high_res_hint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="@dimen/margin_normal"
				android:text="@string/upscale_high_res_hint"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?android:attr/textColorSecondary" />

			<org.koitharu.kotatsu.core.ui.widgets.ListItemTextView
				android:id="@+id/button_clear_upscale_cache"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/upscale_clear_cache"
				app:drawableStartCompat="@drawable/ic_delete" />

		</LinearLayout>

	</androidx.core.widget.NestedScrollView>

</LinearLayout>
